NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=oil_service
DB_SYNCHRONIZE=true

JWT_SECRET=development-secret-change-later
OTP_ENABLED=false

# Add https://localhost for the packaged Capacitor Android app.
CORS_ORIGINS=http://localhost:3001,https://localhost

# Android in-app update. APK URL must use HTTPS. Separate notes with |.
ANDROID_LATEST_VERSION_CODE=0
ANDROID_LATEST_VERSION_NAME=1.1.0
ANDROID_MIN_SUPPORTED_VERSION_CODE=0
ANDROID_APK_URL=
ANDROID_RELEASE_NOTES=
