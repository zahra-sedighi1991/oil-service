# Use the public HTTPS address of the deployed API for release builds.
NUXT_PUBLIC_API_BASE=https://api.example.com/api/v1
NUXT_PUBLIC_PUBLIC_API_BASE=https://api.example.com
NUXT_PUBLIC_WEB_BASE=https://app.example.com

# Development only. Never enable mixed HTTP/HTTPS content in a release build.
CAPACITOR_ALLOW_MIXED_CONTENT=false
