{
  "name": "oil-service-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "generate": "nuxt generate",
    "mobile:generate": "node ./scripts/generate-mobile.mjs",
    "mobile:generate:debug": "node ./scripts/generate-mobile.mjs --debug",
    "mobile:add:android": "cap add android",
    "mobile:sync": "pnpm mobile:generate && cap sync android",
    "mobile:sync:debug": "pnpm mobile:generate:debug && cap sync android",
    "mobile:open": "cap open android",
    "mobile:run": "pnpm mobile:sync:debug && cap run android",
    "mobile:build:debug": "pnpm mobile:sync:debug && cd android && gradlew.bat assembleDebug",
    "mobile:build:release": "pnpm mobile:sync && cd android && gradlew.bat assembleRelease",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@nuxtjs/color-mode": "^3.5.2",
    "@unocss/nuxt": "^66.5.4",
    "modern-screenshot": "4.6.6",
    "nuxt": "^4.1.2",
    "unocss": "^66.5.4",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@iconify-json/lucide": "^1.2.68",
    "@unocss/preset-icons": "^66.5.4",
    "@unocss/preset-wind4": "^66.5.4",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.3.9"
  }
}
