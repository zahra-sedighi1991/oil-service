# Release tag generated by scripts/build-release.ps1
APP_VERSION=latest

# Domain only; do not include https:// or a trailing slash.
DOMAIN=example.ir

DB_NAME=oil_service
DB_USER=oil_service_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Use at least 64 random characters.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

OTP_ENABLED=false

# Optional initial super-admin. Leave all three empty to skip creation.
ADMIN_MOBILE=
ADMIN_PASSWORD=
ADMIN_NAME=
